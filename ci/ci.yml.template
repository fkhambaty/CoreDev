# CI workflow template.
#
# The connected token could not push files under `.github/workflows/` (it lacks
# GitHub's `workflow` OAuth scope). To enable CI, copy this file to
# `.github/workflows/ci.yml` using GitHub's web editor (Add file -> Create new
# file), or re-authenticate a token that has the `workflow` scope and move it.

name: CI

on:
  push:
    branches: ["**"]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.10", "3.11", "3.12"]
    steps:
      - uses: actions/checkout@v4
      - name: Set up Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
      - name: Run tests
        run: pytest -q
